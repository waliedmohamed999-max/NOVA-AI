# NOVA production environment template. No real secrets are included.
# Fill required values in Vercel Settings > Environment Variables.
# DATABASE_URL: hosted PostgreSQL with pgvector; never localhost.
# TEST_DATABASE_URL: leave unset on Vercel; local tests only.
# AUTH_SECRET: unique random secret (32+ characters).
# ENCRYPTION_KEY: unique random 32-byte key encoded as base64.
# Optional providers stay unconfigured until their credentials are added.
# Omit unused optional variables from Vercel instead of importing empty values.
# Configure an external worker for background jobs and S3-compatible file storage.

DATABASE_URL=""
TEST_DATABASE_URL=""
APP_ENV="production"
APP_URL="https://YOUR-PRODUCTION-DOMAIN"
TRUST_PROXY=""
TRUST_PROXY_HEADER=""
AUTH_SECRET=""
ENCRYPTION_KEY=""
EMAIL_PROVIDER=""
RESEND_API_KEY=""
POSTMARK_SERVER_TOKEN=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
GOOGLE_OPTIONAL_SCOPES=""

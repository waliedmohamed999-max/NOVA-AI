# NOVA — STAGING environment template (see docs/STAGING.md)
# Copy to your staging host's secret manager. Never commit real values. Never reuse production secrets.
# Rule: every URL below is the public HTTPS staging origin — providers reject localhost/http callbacks.

NODE_ENV="production"
# development | staging | production — staging enforces the same HTTPS callback audit as production.
APP_ENV="staging"
APP_URL="https://staging.example.com"
TRUST_PROXY="true"
TRUST_PROXY_HEADER=""

# Postgres 15+ with pgvector — a separate staging database (never the production one).
DATABASE_URL="postgresql://nova_staging:CHANGE_ME@db-staging.internal:5432/nova_staging?schema=public"

# Generate fresh: openssl rand -base64 48  /  openssl rand -hex 32  (different from production)
AUTH_SECRET=""
ENCRYPTION_KEY=""
CRON_SECRET=""

# Email — a real provider with a staging sender domain (Mailpit is dev only).
EMAIL_PROVIDER="resend"            # smtp | resend | postmark
RESEND_API_KEY=""
POSTMARK_SERVER_TOKEN=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="NOVA Staging <no-reply@staging.example.com>"

# Storage — a dedicated staging bucket (never the production bucket).
STORAGE_DRIVER="s3"
S3_BUCKET="nova-staging-files"
S3_REGION="auto"
S3_ENDPOINT=""                      # R2: https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_SIGNED_REDIRECT="false"

# AI
OPENAI_API_KEY=""
OPENAI_TEXT_MODEL=""
OPENAI_IMAGE_MODEL_FAST=""
OPENAI_IMAGE_MODEL_QUALITY=""
ANTHROPIC_API_KEY=""
AI_OFFLINE_MODE="false"

# OAuth — register EXACTLY these callback URLs (docs/STAGING.md → callback matrix).
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="https://staging.example.com/api/integrations/meta/callback"
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI="https://staging.example.com/api/integrations/instagram/callback"
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="https://staging.example.com/api/integrations/linkedin/callback"
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="https://staging.example.com/api/integrations/tiktok/callback"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://staging.example.com/api/integrations/google/callback"
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""
MICROSOFT_REDIRECT_URI="https://staging.example.com/api/integrations/microsoft/callback"

# WhatsApp Cloud API (webhook: https://staging.example.com/api/webhooks/whatsapp)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_API_VERSION="v21.0"
# Admin "Send test WhatsApp" only ever sends to this number (E.164), using this approved template outside 24h.
WHATSAPP_TEST_RECIPIENT=""
WHATSAPP_TEST_TEMPLATE="hello_world"
WHATSAPP_TEST_TEMPLATE_LANG="en_US"

# Stripe TEST mode only on staging (sk_test_…, webhook: https://staging.example.com/api/webhooks/stripe)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_SCALE=""

# Workers: run `npm run worker` as its own process.
NOVA_INLINE_WORKER="false"
WORKER_CONCURRENCY="4"

# Observability
LOG_LEVEL="info"
SENTRY_DSN=""
SENTRY_ENVIRONMENT="staging"
SENTRY_RELEASE=""

# Legal pages (docs: src/content/legal.ts). Unset values show "[to be completed by the company]".
LEGAL_COMPANY_NAME=""
LEGAL_CONTACT_EMAIL=""
LEGAL_ADDRESS=""
LEGAL_GOVERNING_LAW=""
LEGAL_HOSTING_REGION=""
LEGAL_LAST_UPDATED=""

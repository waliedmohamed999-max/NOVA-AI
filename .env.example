# ─────────────────────────────────────────────────────────────
# NOVA — AI Growth Team · environment variables
# Copy to .env and fill in. Never commit real secrets.
# Optional provider variables unlock features; when they are empty the
# product shows a "connect / not configured" state instead of faking it.
# ─────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────
# PostgreSQL 15+ with the pgvector extension (docker-compose.yml provides one).
DATABASE_URL="postgresql://nova:nova@localhost:5434/nova?schema=public"
# Separate database used only by `npm test` (it is wiped on every run).
TEST_DATABASE_URL="postgresql://nova:nova@localhost:5434/nova_test?schema=public"
# Public base URL of the app (used in emails, OAuth redirect URIs, embeds).
APP_URL="http://localhost:3000"
# Random secret, 32+ chars. Signs file URLs and other HMACs.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# 32-byte key, base64. Encrypts OAuth tokens and other credentials at rest (AES-256-GCM).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
# Key rotation: add ENCRYPTION_KEY_V2 and bump CURRENT_KEY_VERSION in src/server/crypto.ts.
# ENCRYPTION_KEY_V2=""

# ── Email (verification, magic links, invitations, notifications) ──
# Any SMTP server. Local dev: Mailpit from docker-compose (UI at http://localhost:8025).
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="NOVA <hello@nova.local>"

# ── Sign in with Google (optional) ───────────────────────────
# Redirect URI to register: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── AI providers (at least one for real generation) ──────────
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Which provider the router prefers when both are configured: anthropic | openai
AI_PRIMARY_PROVIDER="anthropic"
# OpenAI model IDs and list prices (USD per 1M tokens) used for routing + cost tracking.
OPENAI_MODEL_BEST="gpt-5"
OPENAI_MODEL_FAST="gpt-5-mini"
OPENAI_PRICE_BEST_INPUT="1.25"
OPENAI_PRICE_BEST_OUTPUT="10"
OPENAI_PRICE_FAST_INPUT="0.25"
OPENAI_PRICE_FAST_OUTPUT="2"
# Set to "false" if your OpenAI models don't accept the reasoning parameter.
OPENAI_REASONING="true"
# Embeddings for knowledge search (1536 dimensions). Without OpenAI, keyword search is used.
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# Image generation for the AI Designer ("none" disables it).
OPENAI_IMAGE_MODEL="gpt-image-1"
# DEVELOPMENT/TEST ONLY: deterministic offline AI (no network, no cost).
# Refused when NODE_ENV=production.
AI_OFFLINE_MODE="false"

# ── Social providers (official APIs, OAuth handled on the backend) ──
# Meta (Facebook Pages + Instagram professional accounts)
# Redirect URI: {APP_URL}/api/integrations/meta/callback
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v23.0"
# LinkedIn — Redirect URI: {APP_URL}/api/integrations/linkedin/callback
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_API_VERSION="202506"
# "true" only after LinkedIn approves the Community Management API (company pages + stats).
LINKEDIN_ORGANIZATION_ACCESS="false"
# TikTok — Redirect URI: {APP_URL}/api/integrations/tiktok/callback
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# ── Billing (payment adapter not bundled; see docs/INTEGRATIONS.md → Billing) ──
# Reserved for a payment-processor adapter. Without one, plan changes report
# "billing not configured" and no payment is ever simulated.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_SCALE=""

# ── Background jobs ──────────────────────────────────────────
# "true": run the job worker inside the Next.js process (local development only).
# Production: set "false" and run `npm run worker` as a separate process.
NOVA_INLINE_WORKER="false"
WORKER_CONCURRENCY="4"
# Optional: protects POST /api/cron/tick for platforms without long-running workers.
CRON_SECRET=""
# Note: the queue and rate limiter use PostgreSQL. No Redis is required.

# ── Storage ──────────────────────────────────────────────────
# Uploaded files (logos, attachments, exports, generated visuals).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".storage"

# ── Observability ────────────────────────────────────────────
LOG_LEVEL="info"
# Reserved for an error-reporting integration (e.g. Sentry).
SENTRY_DSN=""

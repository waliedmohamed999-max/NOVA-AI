# ─────────────────────────────────────────────────────────────
# NOVA — AI Growth Team · environment variables
# Copy to .env and fill in. Never commit real secrets.
# Optional provider variables unlock features; when they are empty the
# product shows a "connect / not configured" state instead of faking it.
# ─────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────
# PostgreSQL 15+ with the pgvector extension (docker-compose.yml provides one).
DATABASE_URL="postgresql://nova:nova@localhost:5434/nova?schema=public"
# Separate database used only by `npm test` (it is wiped on every run).
TEST_DATABASE_URL="postgresql://nova:nova@localhost:5434/nova_test?schema=public"
# Public base URL of the app (used in emails, OAuth redirect URIs, embeds).
# development | staging | production (default: from NODE_ENV). Non-development enforces HTTPS callbacks.
APP_ENV=""
APP_URL="http://localhost:3000"
# Client IPs (rate limits, audit log, sessions). Forwarding headers are client-controlled, so they are
# ignored unless you say a proxy you control sits in front of the app:
#   "false" = direct / unknown (default)   "true" = one proxy (nginx, a load balancer, Render, Fly…)
#   "2"     = two hops (e.g. Cloudflare → load balancer → app)
# Set this in production behind a proxy — otherwise every visitor shares one rate-limit bucket.
TRUST_PROXY="false"
# Optional: read one header set by the trusted edge instead of X-Forwarded-For,
# e.g. "cf-connecting-ip" (Cloudflare) or "x-real-ip" (nginx/Vercel). Only used when TRUST_PROXY is on.
TRUST_PROXY_HEADER=""
# Random secret, 32+ chars. Signs file URLs and other HMACs.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# 32-byte key, base64. Encrypts OAuth tokens and other credentials at rest (AES-256-GCM).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
# Key rotation: add ENCRYPTION_KEY_V2 and bump CURRENT_KEY_VERSION in src/server/crypto.ts.
# ENCRYPTION_KEY_V2=""

# ── Email (verification, magic links, invitations, notifications) ──
# EMAIL_PROVIDER: smtp | resend | postmark (ses is provider-ready, not implemented — use SES SMTP credentials).
# Empty = smtp when SMTP_HOST is set. Mailpit (localhost:1025, UI :8025) is for DEVELOPMENT ONLY.
EMAIL_PROVIDER=""
RESEND_API_KEY=""
POSTMARK_SERVER_TOKEN=""
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="NOVA <hello@nova.local>"

# ── Sign in with Google (optional) ───────────────────────────
# Redirect URI to register: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Google account connection (Gmail send + Calendar) uses the same OAuth client with a second redirect URI:
# {APP_URL}/api/integrations/google/callback — must be listed in the Google Cloud OAuth client.
GOOGLE_REDIRECT_URI=""
# Extra scopes customers may grant later (incremental). Empty = gmail.send + calendar.events + calendar.freebusy.
GOOGLE_OPTIONAL_SCOPES=""

# ── Microsoft account connection (Outlook send + Calendar, Microsoft Graph) ──
# Redirect URI: {APP_URL}/api/integrations/microsoft/callback. TENANT_ID empty = "common" (any work/personal account).
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""
MICROSOFT_REDIRECT_URI=""
# Empty = Mail.Send + Calendars.ReadWrite
MICROSOFT_OPTIONAL_SCOPES=""

# ── AI providers (at least one for real generation) ──────────
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Which provider the router prefers when both are configured: anthropic | openai
AI_PRIMARY_PROVIDER="anthropic"
# OpenAI model IDs and list prices (USD per 1M tokens) used for routing + cost tracking.
# Content Studio text model (overrides OPENAI_MODEL_BEST when set).
OPENAI_TEXT_MODEL=""
OPENAI_MODEL_BEST="gpt-5"
OPENAI_MODEL_FAST="gpt-5-mini"
OPENAI_PRICE_BEST_INPUT="1.25"
OPENAI_PRICE_BEST_OUTPUT="10"
OPENAI_PRICE_FAST_INPUT="0.25"
OPENAI_PRICE_FAST_OUTPUT="2"
# Set to "false" if your OpenAI models don't accept the reasoning parameter.
OPENAI_REASONING="true"
# Embeddings for knowledge search (1536 dimensions). Without OpenAI, keyword search is used.
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# Image generation for the AI Designer ("none" disables it). Fallback when the two below are empty.
OPENAI_IMAGE_MODEL="gpt-image-1"
# Content Studio: "Fast" drafts vs "Highest quality" / edits. Customers only see Fast / Highest quality.
OPENAI_IMAGE_MODEL_FAST="gpt-image-2.5-flare"
OPENAI_IMAGE_MODEL_QUALITY="gpt-image-2.5-sunburst"
# Image pricing is TOKEN-based (not a fixed price per image). USD per 1M tokens — GPT Image 2.5 list prices;
# update these (and the version label) when OpenAI pricing changes.
OPENAI_IMAGE_TEXT_INPUT_USD_PER_1M="5"
OPENAI_IMAGE_IMAGE_INPUT_USD_PER_1M="8"
OPENAI_IMAGE_IMAGE_OUTPUT_USD_PER_1M="30"
OPENAI_IMAGE_PRICING_VERSION="gpt-image-2.5:2026-09"
# Fallback estimate, used ONLY when a response has no (or incomplete) usage. Recorded as "estimated", never as actual.
OPENAI_IMAGE_EST_INPUT_TOKENS_PER_REFERENCE="1500"
OPENAI_IMAGE_EST_OUTPUT_TOKENS_PER_MEGAPIXEL="4000"
# DEVELOPMENT/TEST ONLY: deterministic offline AI (no network, no cost).
# Refused when NODE_ENV=production.
AI_OFFLINE_MODE="false"
# Demo AI until a real key is added (works in production too; labelled "Demo AI" in the app). Remove once OPENAI_API_KEY / ANTHROPIC_API_KEY is set.
AI_DEMO_MODE="false"

# ── Social providers (official APIs, OAuth handled on the backend) ──
# Meta (Facebook Pages + Instagram professional accounts)
META_APP_ID=""
META_APP_SECRET=""
# Must match "Valid OAuth Redirect URIs" in the Meta app exactly. Empty = {APP_URL}/api/integrations/meta/callback
META_REDIRECT_URI=""
META_GRAPH_VERSION="v23.0"
# Permissions are configuration. Meta rejects the WHOLE login ("Invalid Scopes") if any requested
# permission is not enabled for the app, so start small and add permissions as the app is approved.
#   minimal (default) = public_profile + META_OAUTH_SCOPES      configured = exactly META_OAUTH_SCOPES
META_PERMISSION_MODE="minimal"
# First live test: leave empty (OAuth + callback only). Then "pages_show_list" (Page discovery), later e.g.
# "pages_show_list,instagram_basic,pages_manage_posts,read_insights,instagram_content_publish,instagram_manage_insights".
META_OAUTH_SCOPES=""
# Enabled in the app but requested only when a feature needs them (permission upgrade, auth_type=rerequest).
META_OPTIONAL_SCOPES=""
# Facebook Login for Business: configuration id (sent instead of scope). Leave empty for classic Facebook Login.
META_LOGIN_CONFIG_ID=""
# Instagram Direct — Instagram API with Instagram Login (Business/Creator accounts, no Facebook Page needed).
# Credentials: Meta dashboard → Instagram → API setup with Instagram login → "Instagram app ID/secret"
# (different from META_APP_ID / META_APP_SECRET).
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# Register exactly this under "Business login settings → OAuth redirect URIs". Empty = {APP_URL}/api/integrations/instagram/callback
INSTAGRAM_REDIRECT_URI=""
# Requested at login (instagram_business_basic is always included). Add as enabled/approved:
# instagram_business_content_publish, instagram_business_manage_insights, instagram_business_manage_comments, instagram_business_manage_messages
INSTAGRAM_OAUTH_SCOPES=""
# Enabled for the app but requested only when a feature needs them (permission upgrade).
INSTAGRAM_OPTIONAL_SCOPES=""
# LinkedIn (scopes requested: openid profile email w_member_social)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# The BACKEND callback, not /settings/connected-accounts (NOVA returns there afterwards).
# Must match "Authorized redirect URLs" in the LinkedIn app exactly. Empty = {APP_URL}/api/integrations/linkedin/callback
LINKEDIN_REDIRECT_URI=""
LINKEDIN_API_VERSION="202506"
# "true" only after LinkedIn approves the Community Management API (company pages + stats).
LINKEDIN_ORGANIZATION_ACCESS="false"
# TikTok — Redirect URI: {APP_URL}/api/integrations/tiktok/callback
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# ── WhatsApp Business Platform (official Cloud API only — no WhatsApp Web, no personal numbers) ──
# Webhook URL to register in Meta: {APP_URL}/api/webhooks/whatsapp (subscribe to "messages").
# Customers connect their own number with "Connect WhatsApp Business" (Meta Embedded Signup): set the app id +
# signup configuration below. Their token is stored encrypted per workspace. Admins can also link a number
# (phone_number_id) under /admin/providers — those use the platform system-user token.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_EMBEDDED_CONFIG_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_API_VERSION="v21.0"
# Local E2E only (ignored in production): outbound Graph calls go to an in-memory recorder, nothing reaches Meta.
WHATSAPP_FAKE_TRANSPORT="false"
# Optional: default phone number + WABA (diagnostics: phone status, templates, webhook subscription).
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Admin "Send test WhatsApp" only ever sends to this number, with this approved template outside 24h.
WHATSAPP_TEST_RECIPIENT=""
WHATSAPP_TEST_TEMPLATE="hello_world"
WHATSAPP_TEST_TEMPLATE_LANG="en_US"

# ── Billing: Stripe (payments stay OFF until key + webhook secret + prices are all set) ──
# Webhook endpoint: {APP_URL}/api/webhooks/stripe — events: checkout.session.completed,
# customer.subscription.created/updated/deleted, invoice.created/finalized/paid/payment_failed/voided
# Without them, plan changes report "billing not configured" — no payment is ever simulated.
STRIPE_SECRET_KEY=""
# Not needed by hosted Checkout; checked for mode consistency with the secret key.
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_SCALE=""

# ── Background jobs ──────────────────────────────────────────
# "true": run the job worker inside the Next.js process (local development only).
# Production: set "false" and run `npm run worker` as a separate process.
NOVA_INLINE_WORKER="false"
WORKER_CONCURRENCY="4"
# Optional: protects POST /api/cron/tick for platforms without long-running workers.
CRON_SECRET=""
# Note: the queue and rate limiter use PostgreSQL. No Redis is required.

# ── Storage ──────────────────────────────────────────────────
# Uploaded files (logos, attachments, exports, generated visuals).
# "local" = disk (single server only). "s3" = any S3-compatible store: AWS S3, Cloudflare R2, MinIO.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".storage"
# Required when STORAGE_DRIVER="s3". The bucket must be PRIVATE — files are served via signed URLs.
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# R2: https://<account-id>.r2.cloudflarestorage.com (region "auto"). MinIO: http://host:9000. Empty = AWS.
S3_ENDPOINT=""
S3_REGION=""
# Default: path-style when S3_ENDPOINT is set, virtual-hosted on AWS.
S3_FORCE_PATH_STYLE=""
# "true" = redirect downloads to 5-minute presigned URLs instead of streaming through the app.
# (Also adds the bucket origin to the CSP img-src.)
S3_SIGNED_REDIRECT="false"

# ── Observability ────────────────────────────────────────────
LOG_LEVEL="info"
# Sentry: errors from jobs, OAuth, publishing, provider calls and image generation are sent as
# envelopes over HTTPS (no SDK, no request bodies, secrets scrubbed). Empty = structured logs only.
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
SENTRY_RELEASE=""

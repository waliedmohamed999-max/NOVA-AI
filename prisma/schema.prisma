// ───────────────────────────── Identity ─────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  passwordHash    String?
  emailVerifiedAt DateTime?
  locale          String    @default("en")
  avatarUrl       String?
  isPlatformAdmin Boolean   @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions      Session[]
  memberships   OrganizationMember[]
  oauthAccounts OAuthAccount[]
  tokens        VerificationToken[]
  notifications Notification[]

  @@map("users")
}

model Session {
  id                   String   @id @default(cuid())
  tokenHash            String   @unique
  userId               String
  activeOrganizationId String?
  userAgent            String?
  ip                   String?
  expiresAt            DateTime
  lastSeenAt           DateTime @default(now())
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id         String       @id @default(cuid())
  userId     String?
  email      String
  purpose    TokenPurpose
  tokenHash  String       @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@map("verification_tokens")
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model RateLimitBucket {
  key       String   @id
  count     Int
  windowEnd DateTime

  @@index([windowEnd])
  @@map("rate_limit_buckets")
}

// ───────────────────────────── Tenancy ─────────────────────────────

model Organization {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  locale           String           @default("en")
  timezone         String           @default("UTC")
  industry         String?
  website          String?
  onboardingStatus OnboardingStatus @default(NOT_STARTED)
  onboardingData   Json             @default("{}")
  isDemo           Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  members      OrganizationMember[]
  invitations  Invitation[]
  workspaces   Workspace[]
  subscription Subscription?
  aiBudget     AiBudget?

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role      @default(MEMBER)
  tokenHash      String    @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

model Workspace {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  settings     WorkspaceSettings?

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("workspaces")
}

model WorkspaceSettings {
  id                     String        @id @default(cuid())
  organizationId         String
  workspaceId            String        @unique
  salesAutonomy          SalesAutonomy @default(COPILOT)
  autopilotAllowedTasks  String[]      @default([])
  requireContentApproval Boolean       @default(true)
  timezone               String        @default("UTC")
  dailyBriefHour         Int           @default(8)
  weeklyReportDay        Int           @default(1)
  /// Business approval policies (see src/server/approvals/policies.ts).
  policies               Json          @default("{}")
  /// Content studio defaults: "fast" | "quality"; "brand_template" | "ai_creative".
  imageQuality           String        @default("fast")
  imageMode              String        @default("brand_template")
  /// WhatsApp auto-reply level: OFF | DRAFT | SAFE_AUTO | CUSTOM (see src/server/whatsapp/replies.ts).
  whatsappAutoReply      String        @default("DRAFT")
  /// WhatsApp preferences: { goals[], optOutKeywords[], requireConsent } - never credentials.
  whatsappConfig         Json          @default("{}")
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("workspace_settings")
}

// ───────────────────────────── Billing & usage ─────────────────────────────

model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String             @unique
  plan                   PlanTier           @default(STARTER)
  status                 SubscriptionStatus @default(TRIALING)
  billingProvider        String?
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model UsageRecord {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String?
  metric         String
  quantity       Int
  periodStart    DateTime
  createdAt      DateTime @default(now())

  @@index([organizationId, metric, periodStart])
  @@map("usage_records")
}

model AiBudget {
  id                    String   @id @default(cuid())
  organizationId        String   @unique
  monthlyAllowanceMicro BigInt   @default(20000000) // micro-USD (default $20)
  softLimitPercent      Int      @default(80)
  hardLimitEnabled      Boolean  @default(true)
  softLimitNotifiedFor  String? // "YYYY-MM" of last soft-limit notification
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("ai_budgets")
}

// ───────────────────────────── Company Brain ─────────────────────────────

model CompanyProfile {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String   @unique
  name            String
  tagline         String?
  description     String?
  website         String?
  industry        String?
  markets         String[] @default([])
  languages       String[] @default([])
  audience        Json     @default("[]") // [{ name, description, pains[], motivations[] }]
  valueProps      String[] @default([])
  differentiators String[] @default([])
  competitors     String[] @default([])
  goals           String[] @default([])
  primaryGoal     String?
  contentPillars  String[] @default([])
  strategy        Json? // initial strategy produced after onboarding
  discoveries     Json? // onboarding "magic moment" results
  summary         String?
  completeness    Int      @default(0)
  mission         String?
  vision          String?
  businessModel   String?
  brandPromise    String?
  whyChooseUs     String[] @default([])
  countries       String[] @default([])
  /// Per-field provenance: { field: { source, at, by } } — every edit is source-aware.
  fieldSources    Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@map("company_profiles")
}

model Offering {
  id             String       @id @default(cuid())
  organizationId String
  workspaceId    String
  type           OfferingType @default(SERVICE)
  name           String
  description    String?
  priceText      String?
  priceCents     Int?
  currency       String?
  isActive       Boolean      @default(true)
  category       String?
  targetCustomer String?
  problemSolved  String?
  benefits       String[]     @default([])
  features       String[]     @default([])
  deliveryModel  String?
  salesCycle     String?
  upsell         String[]     @default([])
  crossSell      String[]     @default([])
  objections     String[]     @default([])
  proofPoints    String[]     @default([])
  caseStudies    String[]     @default([])
  /// active | draft | retired (isActive mirrors "active")
  status         String       @default("active")
  sourceKind     String       @default("manual")
  sourceId       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, workspaceId])
  @@map("offerings")
}

model BrandKit {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String   @unique
  logoAssetId     String?
  primaryColors   String[] @default([])
  secondaryColors String[] @default([])
  headingFont     String?
  bodyFont        String?
  tone            String?
  voiceTraits     String[] @default([])
  doSay           String[] @default([])
  dontSay         String[] @default([])
  imageStyle      String?
  layoutRules     String[] @default([])
  forbiddenStyles String[] @default([])
  ctaStyle        String?
  hashtagRules    String[] @default([])
  topics          String[] @default([])
  seasonalThemes  String[] @default([])
  forbiddenClaims String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@map("brand_kits")
}

model FileObject {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String?
  storageKey     String    @unique
  fileName       String
  mimeType       String
  sizeBytes      Int
  sha256         String
  purpose        String
  uploadedById   String?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  @@index([organizationId])
  @@map("file_objects")
}

model BrandAsset {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String
  kind           AssetKind
  name           String
  fileId         String?
  url            String?
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now())

  @@index([organizationId, workspaceId])
  @@map("brand_assets")
}

model DesignTemplate {
  id             String       @id @default(cuid())
  organizationId String
  workspaceId    String
  name           String
  format         DesignFormat
  spec           Json // layout spec: canvas size, zones, typography slots
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, workspaceId])
  @@map("design_templates")
}

model KnowledgeSource {
  id             String              @id @default(cuid())
  organizationId String
  workspaceId    String
  type           KnowledgeSourceType
  title          String
  status         ProcessingStatus    @default(PENDING)
  url            String?
  fileId         String?
  rawText        String?
  metadata       Json                @default("{}")
  error          String?
  lastSyncedAt   DateTime?
  /// Paused sources are kept but excluded from retrieval and never refreshed.
  pausedAt       DateTime?
  language       String?
  lastVerifiedAt DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  documents KnowledgeDocument[]

  @@index([organizationId, workspaceId, type])
  @@map("knowledge_sources")
}

model KnowledgeDocument {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  sourceId       String
  title          String
  url            String?
  content        String
  contentHash    String
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  source KnowledgeSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@unique([sourceId, contentHash])
  @@index([organizationId, workspaceId])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id             String                       @id @default(cuid())
  organizationId String
  workspaceId    String
  documentId     String
  sourceId       String
  index          Int
  content        String
  tokenCount     Int
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?
  metadata       Json                         @default("{}")
  createdAt      DateTime                     @default(now())

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, index])
  @@index([organizationId, workspaceId])
  @@index([sourceId])
  @@map("knowledge_chunks")
}

// ───────────────────────────── Agents ─────────────────────────────

model Agent {
  id             String      @id @default(cuid())
  organizationId String
  workspaceId    String
  key            AgentKey
  name           String
  status         AgentStatus @default(IDLE)
  currentTask    String?
  enabled        Boolean     @default(true)
  settings       Json        @default("{}")
  lastActiveAt   DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  runs  AgentRun[]
  tasks AgentTask[]

  @@unique([workspaceId, key])
  @@index([organizationId])
  @@map("agents")
}

model AgentRun {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String
  agentId        String?
  kind           String // e.g. "command", "weekly_plan", "campaign", "website_analysis"
  input          String?
  status         RunStatus @default(QUEUED)
  steps          Json      @default("[]") // [{ key, label, status }] — high level only
  result         Json?
  error          String?
  requestedById  String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())

  agent Agent?      @relation(fields: [agentId], references: [id], onDelete: SetNull)
  tasks AgentTask[]

  @@index([organizationId, workspaceId, createdAt])
  @@map("agent_runs")
}

model AgentTask {
  id             String     @id @default(cuid())
  organizationId String
  workspaceId    String
  agentId        String
  runId          String?
  title          String
  status         TaskStatus @default(OPEN)
  entityType     String?
  entityId       String?
  completedAt    DateTime?
  createdAt      DateTime   @default(now())

  agent Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  run   AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([organizationId, workspaceId, agentId, createdAt])
  @@map("agent_tasks")
}

// ───────────────────────────── Integrations ─────────────────────────────

model Integration {
  id             String            @id @default(cuid())
  organizationId String
  workspaceId    String
  provider       Provider
  status         IntegrationStatus @default(DISCONNECTED)
  statusMessage  String?
  scopes         String[]          @default([])
  lastSyncAt     DateTime?
  lastErrorAt    DateTime?
  lastCheckedAt  DateTime?
  connectedById  String?
  connectedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  accounts    IntegrationAccount[]
  credentials IntegrationCredential[]

  @@unique([workspaceId, provider])
  @@index([organizationId])
  @@map("integrations")
}

model IntegrationAccount {
  id             String          @id @default(cuid())
  organizationId String
  workspaceId    String
  integrationId  String
  platform       SocialPlatform?
  externalId     String
  name           String
  handle         String?
  avatarUrl      String?
  accountType    String?
  isActive       Boolean         @default(true)
  metadata       Json            @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalId])
  @@index([organizationId, workspaceId])
  @@map("integration_accounts")
}

/// Encrypted provider credentials. Never select these outside src/server/integrations.
model IntegrationCredential {
  id               String    @id @default(cuid())
  organizationId   String
  workspaceId      String
  integrationId    String
  accountId        String?
  accessTokenEnc   String
  refreshTokenEnc  String?
  tokenType        String?
  expiresAt        DateTime?
  refreshExpiresAt DateTime?
  keyVersion       Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, accountId])
  @@index([organizationId])
  @@index([expiresAt])
  @@map("integration_credentials")
}

model OAuthState {
  id              String    @id @default(cuid())
  stateHash       String    @unique
  organizationId  String
  workspaceId     String
  userId          String
  provider        String
  codeVerifierEnc String?
  redirectTo      String?
  expiresAt       DateTime
  consumedAt      DateTime?
  /// Diagnostics for platform admins: what was asked for, what the user granted, how it ended.
  requestedScopes String[]  @default([])
  grantedScopes   String[]  @default([])
  outcome         String?
  createdAt       DateTime  @default(now())

  @@index([expiresAt])
  @@map("oauth_states")
}

// ───────────────────────────── Content ─────────────────────────────

model Campaign {
  id             String           @id @default(cuid())
  organizationId String
  workspaceId    String
  name           String
  objective      String
  audience       String?
  offer          String?
  channels       SocialPlatform[] @default([])
  startDate      DateTime?
  endDate        DateTime?
  budgetCents    Int?
  currency       String?
  status         CampaignStatus   @default(DRAFT)
  plan           Json? // { concept, message, creativeDirection, cta, kpis[], schedule[] }
  /// "social" (content campaigns) | "whatsapp" (template sends to CRM contacts).
  channel        String           @default("social")
  /// WhatsApp send state: DRAFT | NEEDS_APPROVAL | SCHEDULED | SENDING | PAUSED | COMPLETED | FAILED | CANCELLED
  waState        String?
  waTemplateId   String?
  waNumberId     String?
  /// Audience filters over the CRM (never a copy of contacts).
  waAudience     Json?
  /// Template variable mapping: { "1": "lead.name", "2": "static:..." }
  waVariables    Json?
  scheduledAt    DateTime?
  sendStartedAt  DateTime?
  completedAt    DateTime?
  createdByAgent AgentKey?
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  content ContentItem[]
  leads   Lead[]

  @@index([organizationId, workspaceId, status])
  @@map("campaigns")
}

model ContentItem {
  id             String         @id @default(cuid())
  organizationId String
  workspaceId    String
  campaignId     String?
  platform       SocialPlatform
  format         ContentFormat  @default(POST)
  status         ContentStatus  @default(DRAFT)
  title          String
  pillar         String?
  hook           String?
  caption        String
  cta            String?
  hashtags       String[]       @default([])
  designBrief    Json?
  aiRationale    String?
  scheduledAt    DateTime?
  publishedAt    DateTime?
  authorAgent    AgentKey?
  authorUserId   String?
  currentVersion Int            @default(1)
  /// Platform adaptation: the post this one was rewritten from for another platform.
  derivedFromId  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  campaign     Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  versions     ContentVersion[]
  assets       ContentAsset[]
  approvals    ContentApproval[]
  publications SocialPublication[]
  socialPosts  SocialPost[]

  @@index([organizationId, workspaceId, status])
  @@index([workspaceId, scheduledAt])
  @@index([campaignId])
  @@map("content_items")
}

model ContentVersion {
  id              String    @id @default(cuid())
  organizationId  String
  workspaceId     String
  contentItemId   String
  version         Int
  hook            String?
  caption         String
  cta             String?
  hashtags        String[]  @default([])
  designBrief     Json?
  changeNote      String?
  /// AI studio metadata: where the version came from and why it should be better (no chain-of-thought).
  source          String?
  reasons         String[]  @default([])
  platformNotes   String?
  visualDirection String?
  qualityCheck    Json?
  promptVersion   String?
  createdByAgent  AgentKey?
  createdById     String?
  createdAt       DateTime  @default(now())

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([contentItemId, version])
  @@index([organizationId])
  @@map("content_versions")
}

model ContentAsset {
  id             String      @id @default(cuid())
  organizationId String
  workspaceId    String
  contentItemId  String
  kind           AssetKind   @default(IMAGE)
  fileId         String?
  url            String?
  altText        String?
  position       Int         @default(0)
  generatedBy    String? // provider name when AI generated
  prompt         String?
  /// AI visuals: status, mode (brand_template | ai_creative | edit), model, prompt version, size, cost.
  status         AssetStatus @default(COMPLETED)
  mode           String?
  provider       String?
  model          String?
  promptKey      String?
  promptVersion  String?
  quality        String?
  preset         String?
  width          Int?
  height         Int?
  parentAssetId  String?
  variant        String?
  instruction    String?
  contentVersion Int?
  errorCode      String?
  costMicro      BigInt      @default(0)
  /// "actual_usage" (priced from the provider's token usage) | "estimated" (fallback estimate, not provider cost).
  costBasis      String?
  pricingVersion String?
  /// { textInputTokens, imageInputTokens, outputTokens }
  usage          Json?
  isSelected     Boolean     @default(false)
  createdById    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([organizationId, contentItemId])
  @@index([organizationId, createdAt])
  @@map("content_assets")
}

model ContentApproval {
  id             String         @id @default(cuid())
  organizationId String
  workspaceId    String
  contentItemId  String
  action         ApprovalAction
  comment        String?
  userId         String?
  version        Int?
  createdAt      DateTime       @default(now())

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([organizationId, contentItemId])
  @@map("content_approvals")
}

// ───────────────────────────── Social ─────────────────────────────

model SocialPost {
  id                   String         @id @default(cuid())
  organizationId       String
  workspaceId          String
  integrationAccountId String?
  contentItemId        String?
  platform             SocialPlatform
  externalId           String
  permalink            String?
  format               ContentFormat?
  caption              String?
  mediaUrl             String?
  pillar               String?
  publishedAt          DateTime
  isDemo               Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  contentItem ContentItem?           @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  metric      SocialMetric?
  snapshots   SocialMetricSnapshot[]

  @@unique([workspaceId, platform, externalId])
  @@index([organizationId, workspaceId, publishedAt])
  @@map("social_posts")
}

model SocialPublication {
  id                   String            @id @default(cuid())
  organizationId       String
  workspaceId          String
  contentItemId        String
  integrationAccountId String?
  platform             SocialPlatform
  status               PublicationStatus @default(PENDING)
  scheduledFor         DateTime
  attempts             Int               @default(0)
  error                String?
  socialPostId         String?
  jobId                String?
  publishedAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([organizationId, workspaceId, status])
  @@index([scheduledFor])
  @@map("social_publications")
}

/// Latest normalized metrics for a post. Nullable = not provided by the platform.
model SocialMetric {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String
  socialPostId    String   @unique
  reach           Int?
  impressions     Int?
  likes           Int?
  comments        Int?
  shares          Int?
  saves           Int?
  clicks          Int?
  videoViews      Int?
  followersGained Int?
  leads           Int?
  conversions     Int?
  engagementRate  Float?
  raw             Json     @default("{}")
  collectedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  socialPost SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)

  @@index([organizationId, workspaceId])
  @@map("social_metrics")
}

/// Immutable history of metric collections.
model SocialMetricSnapshot {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String
  socialPostId    String
  reach           Int?
  impressions     Int?
  likes           Int?
  comments        Int?
  shares          Int?
  saves           Int?
  clicks          Int?
  videoViews      Int?
  followersGained Int?
  leads           Int?
  conversions     Int?
  engagementRate  Float?
  raw             Json     @default("{}")
  capturedAt      DateTime @default(now())

  socialPost SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)

  @@index([socialPostId, capturedAt])
  @@index([organizationId])
  @@map("social_metric_snapshots")
}

model AccountMetricSnapshot {
  id                   String         @id @default(cuid())
  organizationId       String
  workspaceId          String
  integrationAccountId String?
  platform             SocialPlatform
  date                 DateTime       @db.Date
  followers            Int?
  reach                Int?
  impressions          Int?
  profileViews         Int?
  raw                  Json           @default("{}")
  isDemo               Boolean        @default(false)
  createdAt            DateTime       @default(now())

  @@unique([workspaceId, platform, date])
  @@index([organizationId])
  @@map("account_metric_snapshots")
}

// ───────────────────────────── Leads & Sales ─────────────────────────────

model Lead {
  id                  String          @id @default(cuid())
  organizationId      String
  workspaceId         String
  name                String
  company             String?
  email               String?
  phone               String?
  channel             Channel         @default(MANUAL)
  source              String?
  campaignId          String?
  /// Attribution (from UTM parameters / tracked links on lead capture). Never inferred.
  medium              String?
  utmSource           String?
  utmCampaign         String?
  utmContent          String?
  contentItemId       String?
  socialPostId        String?
  landingUrl          String?
  interests           String[]        @default([])
  stage               LeadStage       @default(NEW)
  score               Int             @default(0)
  temperature         LeadTemperature @default(COLD)
  estimatedValueCents Int?
  currency            String          @default("USD")
  ownerId             String?
  lastContactAt       DateTime?
  nextAction          String?
  nextActionAt        DateTime?
  tags                String[]        @default([])
  summary             String?
  intent              String?
  objections          String[]        @default([])
  aiInsight           String?
  stageChangedAt      DateTime        @default(now())
  isDemo              Boolean         @default(false)
  /// Commerce attributes (imports / store): kept in the CRM; the Company Brain only aggregates them.
  city                String?
  country             String?
  externalId          String?
  ordersCount         Int?
  totalSpendCents     Int?
  lastOrderAt         DateTime?
  purchaseCategories  String[]        @default([])
  /// Phone as digits only (E.164 without "+"): the key WhatsApp contacts are matched on (no duplicates).
  phoneDigits         String?
  /// Opted out of WhatsApp messages (STOP or set by a human). Campaigns always exclude them.
  whatsappOptOut      Boolean         @default(false)
  whatsappOptOutAt    DateTime?
  /// Explicit WhatsApp marketing opt-in: true / false / null = unknown.
  whatsappConsent     Boolean?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  campaign      Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  events        LeadEvent[]
  scores        LeadScore[]
  notes         LeadNote[]
  conversations Conversation[]
  opportunities SalesOpportunity[]
  activities    SalesActivity[]

  @@index([organizationId, workspaceId, stage])
  @@index([workspaceId, temperature])
  @@index([workspaceId, email])
  @@index([workspaceId, phoneDigits])
  @@map("leads")
}

/// Immutable lead timeline.
model LeadEvent {
  id             String        @id @default(cuid())
  organizationId String
  workspaceId    String
  leadId         String
  type           LeadEventType
  title          String
  body           String?
  data           Json          @default("{}")
  actorType      ActorType     @default(SYSTEM)
  actorId        String?
  createdAt      DateTime      @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([organizationId])
  @@map("lead_events")
}

model LeadScore {
  id             String          @id @default(cuid())
  organizationId String
  workspaceId    String
  leadId         String
  score          Int
  temperature    LeadTemperature
  reasons        Json            @default("[]")
  method         String // "rules" | "ai:<model>"
  createdAt      DateTime        @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([organizationId])
  @@map("lead_scores")
}

model LeadNote {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  leadId         String
  authorId       String?
  body           String
  createdAt      DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([organizationId])
  @@map("lead_notes")
}

model LeadCaptureForm {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  publicKey      String   @unique
  name           String
  fields         Json // [{ key, label, type, required }]
  allowedOrigins String[] @default([])
  successMessage String?
  campaignId     String?
  isActive       Boolean  @default(true)
  submissions    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, workspaceId])
  @@map("lead_capture_forms")
}

model Conversation {
  id               String             @id @default(cuid())
  organizationId   String
  workspaceId      String
  leadId           String?
  channel          Channel
  subject          String?
  status           ConversationStatus @default(OPEN)
  externalThreadId String?
  summary          String?
  /// WhatsApp: inbound messages not yet opened by a human; needsHuman when a reply needs a person.
  unreadCount      Int                @default(0)
  needsHuman       Boolean            @default(false)
  whatsappNumberId String?
  /// Last customer message: the WhatsApp 24h customer-service window is measured from here.
  lastInboundAt    DateTime?
  lastMessageAt    DateTime           @default(now())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  lead         Lead?                     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([organizationId, workspaceId, lastMessageAt])
  @@index([leadId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  organizationId String
  conversationId String
  kind           ActorType
  name           String?
  handle         String?
  userId         String?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("conversation_participants")
}

model Message {
  /// Channel delivery status reported by the provider (e.g. WhatsApp: sent / delivered / read / failed).
  deliveryStatus String?
  id             String           @id @default(cuid())
  organizationId String
  workspaceId    String
  conversationId String
  direction      MessageDirection
  authorType     ActorType
  authorId       String?
  body           String
  status         MessageStatus
  aiDrafted      Boolean          @default(false)
  externalId     String?
  sentAt         DateTime?
  /// text | template | image | document | audio | video | sticker | location | interactive
  messageType    String           @default("text")
  templateName   String?
  mediaFileId    String?
  mediaMime      String?
  campaignId     String?
  deliveredAt    DateTime?
  readAt         DateTime?
  failedReason   String?
  /// Local intent of an inbound message (opening_hours, pricing, ...): decides what may be answered automatically.
  intent         String?
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([organizationId, externalId])
  @@index([organizationId])
  @@map("messages")
}

model PipelineStage {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String
  stage          LeadStage
  label          String
  position       Int
  probability    Int // 0-100, used for weighted pipeline value
  createdAt      DateTime  @default(now())

  @@unique([workspaceId, stage])
  @@index([organizationId])
  @@map("pipeline_stages")
}

model SalesOpportunity {
  id                     String            @id @default(cuid())
  organizationId         String
  workspaceId            String
  leadId                 String
  title                  String
  /// null = value not known yet (never shown as 0).
  valueCents             Int?
  currency               String            @default("USD")
  status                 OpportunityStatus @default(OPEN)
  /// "DEAL" (from a customer) or "B2B" (a company opportunity).
  kind                   String            @default("DEAL")
  industry               String?
  need                   String?
  decisionMaker          String?
  nextStep               String?
  nextStepAt             DateTime?
  ownerId                String?
  source                 String?
  summary                String?
  qualificationQuestions String[]          @default([])
  expectedCloseAt        DateTime?
  proposal               Json?
  closedAt               DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, workspaceId, status])
  @@map("sales_opportunities")
}

model SalesActivity {
  id             String            @id @default(cuid())
  organizationId String
  workspaceId    String
  leadId         String
  type           SalesActivityType
  title          String
  body           String?
  dueAt          DateTime?
  completedAt    DateTime?
  remindedAt     DateTime?
  /// Paused follow-ups are kept but not due.
  pausedAt       DateTime?
  channel        Channel?
  assignedToId   String?
  createdByAgent AgentKey?
  createdById    String?
  createdAt      DateTime          @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, workspaceId, dueAt])
  @@index([leadId])
  @@map("sales_activities")
}

// ───────────────────────────── Approvals & notifications ─────────────────────────────

model Approval {
  id               String           @id @default(cuid())
  organizationId   String
  workspaceId      String
  category         ApprovalCategory
  action           String // e.g. "publish_content", "send_message", "offer_discount"
  status           ApprovalStatus   @default(PENDING)
  title            String
  summary          String // what the AI wants to do
  reason           String? // why
  impact           String? // potential impact
  entityType       String?
  entityId         String?
  payload          Json             @default("{}")
  requestedByAgent AgentKey?
  requestedById    String?
  decidedById      String?
  decidedAt        DateTime?
  decisionNote     String?
  expiresAt        DateTime?
  createdAt        DateTime         @default(now())

  @@index([organizationId, workspaceId, status, category])
  @@index([entityType, entityId])
  @@map("approvals")
}

model ApprovalPolicy {
  id               String   @id @default(cuid())
  organizationId   String
  workspaceId      String
  action           String // discount | custom_pricing | contract_promise | refund | legal_commitment | unusual_delivery | send_message | publish_content
  requiresApproval Boolean  @default(true)
  config           Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([workspaceId, action])
  @@index([organizationId])
  @@map("approval_policies")
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  workspaceId    String?
  userId         String
  type           NotificationType
  title          String
  body           String?
  link           String?
  data           Json             @default("{}")
  readAt         DateTime?
  emailedAt      DateTime?
  createdAt      DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, organizationId, readAt])
  @@index([organizationId])
  @@map("notifications")
}

model NotificationPreference {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType
  inApp          Boolean          @default(true)
  email          Boolean          @default(false)

  @@unique([organizationId, userId, type])
  @@map("notification_preferences")
}

// ───────────────────────────── AI ─────────────────────────────

model AiRun {
  id             String      @id @default(cuid())
  organizationId String
  workspaceId    String?
  agentKey       AgentKey?
  agentRunId     String?
  task           AiTaskType
  provider       String
  model          String
  inputTokens    Int         @default(0)
  outputTokens   Int         @default(0)
  costMicro      BigInt      @default(0)
  latencyMs      Int         @default(0)
  status         AiRunStatus
  fallbackUsed   Boolean     @default(false)
  error          String?
  /// Prompt registry key + version used for this call.
  promptKey      String?
  promptVersion  String?
  /// Image runs: how costMicro was derived ("actual_usage" | "estimated") and which pricing table.
  costBasis      String?
  pricingVersion String?
  /// The Command Center execution that caused this call (null for other callers).
  commandExecutionId String?
  /// Company Brain context sent with this call (selective retrieval audit): size, items, source types, brain version.
  contextTokens      Int?
  retrievedItems     Int?
  sourceTypes        String[] @default([])
  brainVersion       String?
  createdAt      DateTime    @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, agentKey])
  @@index([organizationId, task, createdAt])
  @@map("ai_runs")
}

/// Monthly rollup per organization/agent for fast budget checks.
model AiUsage {
  id             String   @id @default(cuid())
  organizationId String
  period         String // YYYY-MM
  agentKey       String   @default("none")
  requests       Int      @default(0)
  inputTokens    BigInt   @default(0)
  outputTokens   BigInt   @default(0)
  costMicro      BigInt   @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, period, agentKey])
  @@map("ai_usage")
}

/// Structured, append-only AI insights. New analysis archives older insights instead of overwriting.
model AiInsight {
  id             String        @id @default(cuid())
  organizationId String
  workspaceId    String
  scope          InsightScope
  subjectType    String?
  subjectId      String?
  kind           String // performance_comparison | recommendation | learning | anomaly
  title          String
  body           String
  evidence       Json          @default("{}") // the data that backs every claim
  confidence     Float?
  status         InsightStatus @default(ACTIVE)
  supersededById String?
  periodStart    DateTime?
  periodEnd      DateTime?
  generatedBy    String // "rules" | "ai:<model>"
  isDemo         Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@index([organizationId, workspaceId, scope, status])
  @@index([subjectType, subjectId])
  @@map("ai_insights")
}

model Report {
  id             String     @id @default(cuid())
  organizationId String
  workspaceId    String
  kind           ReportKind
  periodStart    DateTime
  periodEnd      DateTime
  data           Json
  narrative      String?
  generatedBy    String
  createdAt      DateTime   @default(now())

  @@unique([workspaceId, kind, periodStart])
  @@index([organizationId])
  @@map("reports")
}

// ───────────────────────────── Jobs ─────────────────────────────

model Job {
  id             String    @id @default(cuid())
  type           String
  payload        Json      @default("{}")
  status         JobStatus @default(QUEUED)
  priority       Int       @default(0)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  runAt          DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  result         Json?
  dedupeKey      String?   @unique
  organizationId String?
  workspaceId    String?
  createdAt      DateTime  @default(now())
  finishedAt     DateTime?

  runs JobRun[]

  @@index([status, runAt, priority])
  @@index([organizationId, createdAt])
  @@map("jobs")
}

model JobRun {
  id         String    @id @default(cuid())
  jobId      String
  attempt    Int
  status     JobStatus
  error      String?
  durationMs Int?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_runs")
}

model ScheduledJob {
  id              String    @id @default(cuid())
  key             String    @unique
  type            String
  intervalSeconds Int
  payload         Json      @default("{}")
  enabled         Boolean   @default(true)
  nextRunAt       DateTime
  lastRunAt       DateTime?
  organizationId  String?
  workspaceId     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([enabled, nextRunAt])
  @@map("scheduled_jobs")
}

// ───────────────────────────── Audit & privacy ─────────────────────────────

/// Append-only. Updates are blocked by a database trigger (see migration).
model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  workspaceId    String?
  category       AuditCategory @default(BUSINESS)
  actorType      ActorType
  actorId        String?
  actorLabel     String?
  action         String
  entityType     String?
  entityId       String?
  summary        String
  metadata       Json          @default("{}")
  ip             String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([category, createdAt])
  @@map("audit_logs")
}

model DataExport {
  id             String       @id @default(cuid())
  organizationId String
  requestedById  String
  status         ExportStatus @default(PENDING)
  fileId         String?
  error          String?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  completedAt    DateTime?

  @@index([organizationId])
  @@map("data_exports")
}

// ───────────────────────────── Billing records ─────────────────────────────

/// Raw provider webhook events, stored once (idempotency) and processed asynchronously-safe.
model BillingEvent {
  id             String    @id @default(cuid())
  provider       String
  externalId     String
  type           String
  organizationId String?
  payload        Json
  processedAt    DateTime?
  error          String?
  createdAt      DateTime  @default(now())

  @@unique([provider, externalId])
  @@index([organizationId])
  @@map("billing_events")
}

model Invoice {
  id                String    @id @default(cuid())
  organizationId    String
  provider          String
  providerInvoiceId String
  status            String
  amountDueCents    Int
  amountPaidCents   Int
  currency          String
  hostedUrl         String?
  periodStart       DateTime?
  periodEnd         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([provider, providerInvoiceId])
  @@index([organizationId, createdAt])
  @@map("invoices")
}

// ───────────────────────────── Meetings ─────────────────────────────

enum MeetingStatus {
  PROPOSED
  BOOKED
  CANCELLED
}

/// A sales meeting: proposed slots from real calendar availability, then a real calendar event once booked.
model Meeting {
  id              String        @id @default(cuid())
  organizationId  String
  workspaceId     String
  leadId          String
  integrationId   String?
  provider        String?
  externalEventId String?
  joinUrl         String?
  title           String
  timezone        String        @default("UTC")
  durationMin     Int           @default(30)
  proposedSlots   Json          @default("[]")
  startAt         DateTime?
  endAt           DateTime?
  attendeeEmail   String?
  status          MeetingStatus @default(PROPOSED)
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organizationId, workspaceId, leadId])
  @@map("meetings")
}

// ───────────────────────────── Carousel ─────────────────────────────

/// One slide of a carousel post. Each slide keeps its own history, so one slide can be rewritten alone.
model CarouselSlide {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String
  contentItemId   String
  position        Int
  headline        String
  body            String   @default("")
  visualDirection String?
  assetId         String?
  version         Int      @default(1)
  history         Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([contentItemId, position])
  @@index([organizationId, contentItemId])
  @@map("carousel_slides")
}

// ───────────────────────────── Live readiness ─────────────────────────────

/// Result of a manual, admin-run live check against a real provider (never part of automated tests).
model ProviderValidation {
  id             String   @id @default(cuid())
  provider       String
  check          String
  ok             Boolean
  /// true = executed against the real provider API with real credentials.
  live           Boolean  @default(true)
  detail         String?
  /// Admin incident detail: provider HTTP status and error code, duration, non-secret metadata (message id, bucket…).
  httpStatus     Int?
  errorCode      String?
  durationMs     Int?
  meta           Json     @default("{}")
  costMicro      BigInt   @default(0)
  organizationId String?
  actorId        String?
  createdAt      DateTime @default(now())

  @@index([provider, createdAt])
  @@map("provider_validations")
}

// ───────────────────────────── WhatsApp Business Platform ─────────────────────────────

/// A WhatsApp Business phone number (Cloud API phone_number_id) linked to one workspace by an admin.
/// Inbound webhooks are routed by phoneNumberId. Tokens live in env (WHATSAPP_ACCESS_TOKEN), never here.
model WhatsAppNumber {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String
  phoneNumberId  String    @unique
  wabaId         String?
  displayPhone   String?
  verifiedName   String?
  isActive       Boolean   @default(true)
  /// Embedded Signup: the Integration whose encrypted credential holds this business's token (null: platform token).
  integrationId  String?
  /// connected | reconnect_needed | disconnected
  status         String    @default("connected")
  qualityRating  String?
  messagingLimit String?
  connectedAt    DateTime  @default(now())
  lastWebhookAt  DateTime?
  lastSendAt     DateTime?
  lastCheckedAt  DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, workspaceId])
  @@map("whatsapp_numbers")
}

/// One CRM contact inside a WhatsApp campaign (the audience is resolved from Lead - contacts are not copied).
/// QUEUED -> SENDING -> SENT -> DELIVERED -> READ, or FAILED / SKIPPED / CANCELLED. Provider-reported states only.
model CampaignRecipient {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String
  campaignId     String
  leadId         String
  phone          String
  status         String    @default("QUEUED")
  variables      Json      @default("[]")
  messageId      String?
  externalId     String?
  error          String?
  attempts       Int       @default(0)
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  repliedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([campaignId, leadId])
  @@index([campaignId, status])
  @@index([organizationId, externalId])
  @@map("campaign_recipients")
}

/// WhatsApp message templates: local drafts + the status Meta reports. Only APPROVED ones can be sent.
model WhatsAppTemplate {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String
  name           String
  language       String
  /// MARKETING | UTILITY | AUTHENTICATION
  category       String
  /// DRAFT | PENDING | APPROVED | REJECTED | PAUSED | DISABLED
  status         String    @default("DRAFT")
  header         String?
  body           String
  footer         String?
  buttons        Json      @default("[]")
  /// { "1": "lead.name", ... } - what each {{n}} is filled with.
  variables      Json      @default("{}")
  externalId     String?
  rejectedReason String?
  lastSyncedAt   DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, name, language])
  @@index([organizationId, workspaceId, status])
  @@map("whatsapp_templates")
}

/// Workspace suppression list: these numbers never receive WhatsApp campaigns.
model WhatsAppSuppression {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  phone          String
  /// opt_out | blocked | invalid | manual
  reason         String
  note           String?
  createdById    String?
  createdAt      DateTime @default(now())

  @@unique([workspaceId, phone])
  @@index([organizationId])
  @@map("whatsapp_suppressions")
}

/// Failed or slow calls to external provider APIs (observability). URL path only — never query strings or bodies.
model ProviderCall {
  id         String   @id @default(cuid())
  host       String
  path       String
  method     String
  status     Int?
  kind       String
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([host, createdAt])
  @@map("provider_calls")
}

// ───────────────────────────── Quotes ─────────────────────────────

enum QuoteStatus {
  DRAFT
  NEEDS_APPROVAL
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

/// A price quote / proposal for a lead (optionally tied to an opportunity). Not an invoice.
model Quote {
  id             String      @id @default(cuid())
  organizationId String
  workspaceId    String
  leadId         String
  opportunityId  String?
  number         String
  title          String
  /// [{ description, quantity, unitCents }]
  items          Json        @default("[]")
  subtotalCents  Int
  discountCents  Int         @default(0)
  taxCents       Int         @default(0)
  totalCents     Int
  currency       String      @default("USD")
  terms          String?
  status         QuoteStatus @default(DRAFT)
  validUntil     DateTime?
  createdById    String?
  createdByAgent Boolean     @default(false)
  approvedById   String?
  approvedAt     DateTime?
  sentAt         DateTime?
  sentVia        String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([organizationId, workspaceId, status])
  @@index([leadId])
  @@map("quotes")
}

/// Home Command Center: one row per command (activity log, history, idempotency, pending confirmations).
/// `plan` holds the server-resolved action awaiting a choice/confirmation — the client never sends entity ids.
model CommandExecution {
  id               String   @id @default(cuid())
  organizationId   String
  workspaceId      String
  userId           String
  idempotencyKey   String
  text             String // redacted
  locale           String   @default("en")
  intent           String?
  kind             String? // navigation | read | action | high_risk | unknown
  entities         Json     @default("{}")
  action           String?
  status           String // understood | completed | failed | denied | needs_choice | needs_confirmation | needs_approval | needs_input | queued | partial | ai_unavailable
  response         Json     @default("{}")
  plan             Json?
  receipt          Json?
  runId            String?
  aiUsed           Boolean  @default(false)
  approvalRequired Boolean  @default(false)
  errorCode        String?
  errorDetail      String?
  latencyMs        Int?
  /// Routing decided before execution: local | brain | ai | brain_ai.
  mode             String?
  /// { requiredData[], requiredBrainSections[], tokenBudget, maxOutputTokens }
  routing          Json?
  brainVersion     String?
  cacheHit         Boolean  @default(false)
  contextTokens    Int?
  retrievedItems   Int?
  inputTokens      Int?
  outputTokens     Int?
  costMicro        BigInt?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([organizationId, userId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([organizationId, workspaceId, userId, createdAt])
  @@map("command_executions")
}

/// Answers built only from the Company Brain (no customer data, no time-sensitive data), keyed by the
/// brain fingerprint: any change to profile, offerings, brand, policies or knowledge makes old rows unreachable.
model CommandCache {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  brainVersion   String
  intent         String
  queryKey       String
  locale         String
  response       Json
  hits           Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, workspaceId, brainVersion, intent, queryKey, locale])
  @@index([organizationId, workspaceId, createdAt])
  @@map("command_cache")
}

// ── Company Brain (Company Intelligence OS) ──
// Structured first; every row is workspace-scoped and source-aware. CRM customers, content and
// opportunities are referenced/aggregated, never copied here.

/// Structured facts layer (key → value) with provenance, trust and approval. Retrieval reads these first.
model BrainFact {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String
  key            String
  value          String
  category       String
  /// manual | crm | website | document | public_web | ai
  sourceKind     String    @default("manual")
  sourceId       String?
  confidence     Float     @default(1)
  /// approved | pending | rejected — critical facts extracted by machines start as pending.
  status         String    @default("approved")
  critical       Boolean   @default(false)
  verifiedAt     DateTime?
  updatedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, key])
  @@index([organizationId, workspaceId, category])
  @@map("brain_facts")
}

model BrainFaq {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  question       String
  answer         String
  category       String?
  audience       String?
  channel        String?
  status         String   @default("approved")
  sourceKind     String   @default("manual")
  sourceId       String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, workspaceId, status])
  @@map("brain_faqs")
}

model BrainObjection {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  objection      String
  response       String
  proof          String?
  /// draft_only | auto_allowed
  automation     String   @default("draft_only")
  status         String   @default("approved")
  sourceKind     String   @default("manual")
  sourceId       String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, workspaceId])
  @@map("brain_objections")
}

model Competitor {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String
  name           String
  website        String?
  positioning    String?
  services       String[]  @default([])
  pricing        String?
  strengths      String[]  @default([])
  weaknesses     String[]  @default([])
  contentThemes  String[]  @default([])
  channels       String[]  @default([])
  notes          String?
  sourceKind     String    @default("manual")
  sourceId       String?
  lastVerifiedAt DateTime?
  updatedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, workspaceId])
  @@map("competitors")
}

/// Segments are definitions over CRM customers (criteria), sized from the CRM — never a copy of customers.
model CustomerSegment {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String
  name           String
  definition     String?
  /// { city?, country?, minOrders?, maxOrders?, minSpendCents?, category?, tag?, source? }
  criteria       Json      @default("{}")
  size           Int?
  sizedAt        DateTime?
  /// manual | rules | ai
  source         String    @default("manual")
  /// suggested | approved | rejected
  status         String    @default("approved")
  notes          String?
  updatedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, workspaceId, status])
  @@map("customer_segments")
}

model IdealCustomerProfile {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  /// B2B | B2C
  kind           String   @default("B2B")
  name           String
  industry       String?
  companySize    String?
  location       String?
  budget         String?
  painPoints     String[] @default([])
  buyingTriggers String[] @default([])
  decisionMaker  String?
  objections     String[] @default([])
  salesCycle     String?
  channels       String[] @default([])
  status         String   @default("approved")
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, workspaceId])
  @@map("ideal_customer_profiles")
}

model Strategy {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String
  /// business | marketing | sales | content | retention
  type           String
  title          String
  objective      String?
  targetAudience String?
  positioning    String?
  channels       String[]  @default([])
  kpis           String[]  @default([])
  initiatives    String[]  @default([])
  risks          String[]  @default([])
  timeline       String?
  owner          String?
  /// DRAFT | REVIEW | APPROVED | ARCHIVED — nothing generated is approved automatically.
  status         String    @default("DRAFT")
  /// manual | template | ai | offline
  generatedBy    String    @default("manual")
  inputs         Json      @default("{}")
  approvedById   String?
  approvedAt     DateTime?
  updatedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, workspaceId, type])
  @@map("strategies")
}

model SalesKnowledge {
  id                     String   @id @default(cuid())
  organizationId         String
  workspaceId            String   @unique
  playbook               String?
  qualificationQuestions String[] @default([])
  discoveryQuestions     String[] @default([])
  pricingRules           String[] @default([])
  discountRules          String[] @default([])
  proposalRules          String[] @default([])
  followUpCadence        String?
  redFlags               String[] @default([])
  escalationRules        String[] @default([])
  updatedById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([organizationId])
  @@map("sales_knowledge")
}

/// A brain import job: parse locally → (optional AI extraction) → human review → import.
model BrainImport {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String
  /// website | store | csv | excel | pdf | docx | txt
  kind           String
  /// UPLOADED | PARSING | EXTRACTING | REVIEW | IMPORTED | FAILED
  status         String    @default("UPLOADED")
  title          String
  fileId         String?
  url            String?
  sourceId       String?
  /// Parsed preview: text excerpt / columns + sample rows / detected platform.
  preview        Json      @default("{}")
  /// Extracted candidates awaiting review: [{ id, type, data, selected, critical }]
  candidates     Json      @default("[]")
  mapping        Json?
  stats          Json      @default("{}")
  error          String?
  createdById    String?
  importedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, workspaceId, createdAt])
  @@map("brain_imports")
}

/// Edit history for every Company Brain change: who, when, source, before/after.
model BrainRevision {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  entityType     String
  entityId       String
  /// create | update | delete | approve | reject
  action         String
  before         Json?
  after          Json?
  sourceKind     String   @default("manual")
  actorId        String?
  createdAt      DateTime @default(now())

  @@index([organizationId, workspaceId, entityType, entityId])
  @@index([organizationId, workspaceId, createdAt])
  @@map("brain_revisions")
}

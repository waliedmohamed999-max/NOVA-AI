// NOVA — AI Growth Team
// Multi-tenant schema. Every tenant-owned row carries `organizationId`
// (and `workspaceId` where the data belongs to a workspace). Tenant scoping is
// enforced server-side by the tenant Prisma extension in src/server/db/tenant.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  MAGIC_LINK
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  ANALYZING
  COMPLETED
}

enum PlanTier {
  STARTER
  GROWTH
  SCALE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
